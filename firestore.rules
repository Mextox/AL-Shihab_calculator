rules_version = '2';

// قواعد أمان Firestore لحاسبة تمويل السيارات.
//
// القراءة متاحة للجميع حتى تعمل الحاسبة دون تسجيل دخول، أما الكتابة
// فمقصورة على المستخدمين المسجّلين في Firebase Authentication.
//
// مهم: الكتابة تشترط صلاحية admin وليس مجرد تسجيل الدخول. تسجيل الحسابات
// في Firebase مفتوح للعموم افتراضياً، فشرط request.auth != null وحده يسمح
// لأي غريب بإنشاء حساب ثم تعديل السقف ونسب الربح.
//
// تُمنح الصلاحية عبر custom claim من حساب خدمة:
//   accounts:update  →  customAttributes: {"admin": true}
//
// ملاحظة: دوال التحقق يجب أن تُعرَّف داخل كتلة match، فتعريفها خارج
// كتلة service خطأ صياغة يرفضه Firebase عند النشر.
//
// للنشر: لوحة Firebase ← Firestore Database ← Rules ← الصق هذا الملف ← Publish

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // التحقق من الإعدادات حتى لا تُكتب قيم تُفسد الحسابات
    function isValidSettings(data) {
      return data.ceiling is number && data.ceiling > 0
          && data.profitRate is number
          && data.profitRate >= 0 && data.profitRate <= 100
          && data.discountedRate is number
          && data.discountedRate >= 0 && data.discountedRate <= 100;
    }

    function isValidCar(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 120
          && data.price is number && data.price > 0
          && data.closingType in ['none', 'fixed', 'range']
          && (data.closingType != 'fixed'
              || (data.closingPrice is number && data.closingPrice > 0))
          && (data.closingType != 'range'
              || (data.closingMin is number && data.closingMin > 0
                  && data.closingMax is number && data.closingMax >= data.closingMin))
          && (!('imageUrl' in data) || data.imageUrl is string);
    }

    // الإعدادات المالية: سقف المرابحة وهوامش الربح
    match /config/{document} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidSettings(request.resource.data);
    }

    // قائمة السيارات المحفوظة
    match /cars/{carId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidCar(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
